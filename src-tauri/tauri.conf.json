{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LarkPM",
  "version": "1.0.3",
  "identifier": "local.larkpm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1421"
  },
  "app": {
    "windows": [
      {
        "title": "LarkPM · 需求工作台",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar/larkpm-backend.exe"
    ]
  }
}
